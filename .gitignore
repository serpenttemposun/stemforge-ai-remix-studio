# stemforge-ai-remix-studio
# Python desktop tool — AI remix / stem separation generator

# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class
*.so

# C extensions / compiled model kernels
*.dll
*.pyd
*.dylib
build/
dist/
*.egg-info/
.eggs/
wheels/
*.whl

# Virtual environments
.venv/
venv/
env/
ENV/
.python-version

# Model weights & caches — do NOT commit these
models/checkpoints/*.ckpt
models/checkpoints/*.onnx
models/checkpoints/*.pt
models/checkpoints/*.safetensors
models/cache/
models/downloads/
!models/checkpoints/.gitkeep

# Stem render output
output/
stems/
renders/
*.stemcache

# User config (may contain API keys for cloud inference)
config/local.toml
config/secrets.env
.env

# IDE
.idea/
.vscode/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db
desktop.ini

# Test / coverage
.pytest_cache/
.coverage
htmlcov/
.tox/
.mypy_cache/
.ruff_cache/

# Logs
logs/
*.log

# PyInstaller / Nuitka build artifacts
*.spec.bak
main.build/
main.dist/